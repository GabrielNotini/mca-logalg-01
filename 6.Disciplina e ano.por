programa {
  funcao inicio() {

    cadeia nome_aluno
    cadeia disciplina
    inteiro ano

    escreva ("Digite o seu nome: ")
    leia(nome_aluno)
    escreva("Digite o nome da disciplina: ")
    leia(disciplina)
    escreva("Digite o ano que está cursando: ")
    leia(ano)

    escreva("Nome do aluno: ",nome_aluno)
    escreva("\nNome da disciplina: ",disciplina)
    escreva("\nAno do curso: ",ano)
    
  }
}
